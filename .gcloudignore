# What `gcloud run deploy --source` uploads to Cloud Build. Keep it to the files the
# Dockerfile needs — the WhatsApp session folder alone is 350 MB.
.git
.gitignore
.env
.env.*
whatsapp-session
.wwebjs_auth
.wwebjs_cache
node_modules
.next
out
*.tsbuildinfo
.vercel
docs
scripts
src/scripts
public/models
